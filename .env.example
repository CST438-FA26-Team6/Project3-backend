# Safe local-development values. Do not reuse these values in production.
POSTGRES_DB=project3
POSTGRES_USER=project3
POSTGRES_PASSWORD=project3-local-only
POSTGRES_PORT=5432
API_PORT=8080

APP_JWT_ISSUER=http://localhost:8080
# Base64 for a 32-byte development-only signing key.
APP_JWT_SECRET_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
APP_JWT_TTL=PT1H
APP_CORS_ORIGINS=http://localhost:8081

# OAuth values are optional for startup and automated tests but required for
# real login. Never commit a populated .env file or share client secrets.

# GitHub OAuth App for local development.
# Homepage: http://localhost:8081
# Callback URL: http://localhost:8081/auth
# The Client ID must match EXPO_PUBLIC_GITHUB_CLIENT_ID in the frontend .env.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client of type "Web application".
# Authorized JavaScript origin: http://localhost:8081
# Authorized redirect URI: http://localhost:8081/auth
# The Client ID must match EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID in the frontend .env.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
